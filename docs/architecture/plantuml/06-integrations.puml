@startuml 06-integrations
title Внешние системы: реальные и моки по точкам интеграции
left to right direction

skinparam rectangle {
  BackgroundColor #dbeafe
  BorderColor #1d4ed8
  BackgroundColor<<ext>> #e5e7eb
  BorderColor<<ext>> #4b5563
  BackgroundColor<<mock>> #ffedd5
  BorderColor<<mock>> #c2410c
}

legend right
  синий - наша система
  серый - внешняя реальная система
  оранжевый - мок, заглушка, демо, фолбэк
  пунктир - необязательно, фолбэк или подмена
endlegend

' left to right direction выкладывает пакеты снизу вверх,
' поэтому они объявлены в обратном порядке

package "Доставка и мониторинг" {
  rectangle "GitHub Actions" as gh8
  rectangle "VPS: deploy.sh" as vps8
  rectangle "стенд: healthcheck,\nглавная, вебхук" as stand8
  rectangle "MAX Bot API:\nсообщение капитану" <<ext>> as botapi8
  gh8 --> vps8 : push в master
  gh8 --> stand8 : uptime.yml
  gh8 ..> botapi8 : при сбое
}

package "Данные домов и демо" {
  rectangle "seed" as seed7
  rectangle "бот /start" as bot7
  rectangle "Реформа ЖКХ\nдома, УК" <<ext>> as reforma
  rectangle "ГИС ЖКХ\nкадастр, износ" <<ext>> as gis
  rectangle "17 демо-УК, модельные\nжители и начисления за полгода" <<mock>> as demo7
  rectangle "demo_resident_N, demo_staff_N,\ndemo_admin_N, demo_executor_N" <<mock>> as links7
  seed7 ..> reforma : выгрузка заранее
  seed7 ..> gis : выгрузка заранее
  seed7 --> demo7
  bot7 --> links7
}

package "Деньги и документы" {
  rectangle "ChargesService" as charges
  rectangle "pdf/gji" as pdf6
  rectangle "Эквайринг" <<ext>> as acq
  rectangle "Демо-оплата: paid_at = now" <<mock>> as pay
  rectangle "Биллинг УК" <<ext>> as bill
  rectangle "Модельные начисления" <<mock>> as modelbill
  rectangle "ГЖИ" <<ext>> as gzhi
  charges ..> acq : не делаем
  charges --> pay
  charges ..> bill : точка интеграции
  charges --> modelbill
  pdf6 ..> gzhi : житель подает сам
}

package "Карта" {
  rectangle "MapLibre + nginx /tiles/" as map5
  rectangle "NominatimClient" as geo5
  rectangle "OpenFreeMap, OSM" <<ext>> as tiles
  rectangle "выбор дома списком" <<mock>> as list5
  rectangle "Nominatim" <<ext>> as nom
  rectangle "ошибка геокодера,\nдом только из справочника" <<mock>> as nogeo
  map5 --> tiles : промах кэша
  map5 ..> list5 : нет WebGL или ошибка
  geo5 --> nom : 1 rps, кэш 30 дней
  geo5 ..> nogeo : ожидание слота дольше 1,5 с
}

package "ИИ: Yandex Cloud" {
  rectangle "YandexClassifier" as cls
  rectangle "VisionClient" as vis
  rectangle "SpeechClient" as stt4
  rectangle "AI Studio\nyandexgpt-5-lite" <<ext>> as llm
  rectangle "кнопки категорий\nи правила danger" <<mock>> as rules
  rectangle "Vision OCR" <<ext>> as ocr
  rectangle "житель вводит число" <<mock>> as manual
  rectangle "SpeechKit" <<ext>> as stt
  rectangle "просьба написать текстом" <<mock>> as text4
  cls --> llm : ключ задан
  cls ..> rules : нет ключа, отказ, таймаут,\n60 в час исчерпаны
  vis --> ocr : ключ задан
  vis ..> manual : нет ключа или сбой
  stt4 --> stt : MAX не расшифровал
  stt4 ..> text4 : нет ключа или сбой
}

package "Бот" {
  rectangle "api: maxo" as api3
  rectangle "worker: MaxSender, keep_webhook" as worker3
  rectangle "MAX Bot API" <<ext>> as botapi
  rectangle "опрос GET /updates\nбез домена и сертификата" <<mock>> as polling
  api3 --> botapi : MAX_BOT_MODE=webhook
  api3 ..> polling : MAX_BOT_MODE=polling, локально
  worker3 --> botapi
}

package "Бэкенд для фронтенда" {
  rectangle "Мини-приложение" as fe2
  rectangle "api за nginx" as back
  rectangle "mock-config-server :31299\nпочти весь openapi.yaml" <<mock>> as mcs
  fe2 --> back : prod и compose
  fe2 ..> mcs : pnpm mock, DEV_API_TARGET
}

package "Запуск и авторизация" {
  rectangle "Мини-приложение" as fe1
  rectangle "DATA-API, curl" as checker
  rectangle "MAX Bridge: initData" <<ext>> as bridge
  rectangle "WebAppData = dev" <<mock>> as devinit
  rectangle "экран outside-max" <<mock>> as outside
  rectangle "Bearer API_TEST_TOKEN:\nучетка «Проверяющий API»,\nдемо-УК №5" <<mock>> as token
  fe1 --> bridge : внутри MAX
  fe1 ..> devinit : dev-сборка вне MAX
  fe1 ..> outside : прод-сборка вне MAX
  checker ..> token : без MAX
}
@enduml
