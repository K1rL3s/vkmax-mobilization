@startuml 03-backend-components
!include <C4/C4_Component>
!include _style.iuml

title Компоненты бэкенда: пакет zheka

ContainerDb(db, "PostgreSQL", "16.9")
ContainerDb(redis, "Redis", "7.4")
ContainerDb(files, "/data/files", "bind mount")
System_Ext(botapi, "MAX Bot API")
System_Ext(yc, "Yandex Cloud", "AI Studio, Vision, SpeechKit")
System_Ext(osm, "Nominatim")

Container_Boundary(zheka, "zheka") {
  Component(httptx, "api/middlewares", "Starlette", "trace id, транзакция: commit ниже 400, затем publisher.flush")
  Component(routes, "api/routes", "FastAPI", "Житель, admin/*, map, files, demo")
  Component(deps, "api/dependencies", "Depends", "current_user: initData или тестовый токен; current_org по X-Org-Id; current_residency; idempotency")
  Component(bot, "bot", "maxo Dispatcher, maxo.dialogs", "Сценарии: onboarding, requests, executor, chats, meter_photo, review, access, forget. Middlewares: user, transaction, throttling")
  Component(broker, "broker", "taskiq", "worker: прием задач + шедулер. notifications, chats, bot_requests, meters, requests, reminders, digest, webhook, files, idempotency")
  Component(publisher, "broker/publisher", "TaskPublisher", "Копит задачи, ставит в Redis после коммита")
  Component(services, "core/services", "Python", "Заявки и группы, счетчики, начисления, опросы, объявления, прием и доступ, УК, дом и карта, demo")
  Component(domain, "core: models, enums, masking, danger", "Python", "Сущности без SQLAlchemy, mask_pii, правила аварии, pp290.json, workdays")
  Component(repos, "infra/database", "SQLAlchemy async", "41 таблица, map_imperatively, scoped_to_org")
  Component(sender, "infra/max/MaxSender", "maxo Bot", "30 rps на бот, 2 rps на чат, один повтор после 429")
  Component(classifier, "infra/yandex/YandexClassifier", "aiohttp", "AI Studio, 3 с")
  Component(vision, "infra/yandex/VisionClient", "aiohttp", "Vision OCR, 3 с")
  Component(speech, "infra/yandex/SpeechClient", "aiohttp", "SpeechKit, 10 с")
  Component(quota, "infra/quota", "в памяти процесса", "Yandex 60 в час, загрузки 30 в час, новые дома 5 в час")
  Component(geo, "infra/nominatim", "aiohttp + Redis", "Слот 1 rps, кэш 30 дней")
  Component(pdf, "infra/pdf", "fpdf2", "Жалоба в ГЖИ, реестр уведомлений")
  Component(seed, "seed", "Python", "Справочник домов из CSV, 17 демо-УК")
  Component(di, "di", "dishka", "STRICT_VALIDATION, provide_all")
}

Rel(httptx, routes, "оборачивает")
Rel(routes, deps, "Depends")
Rel(routes, services, "вызывает")
Rel(routes, quota, "лимиты")
Rel(routes, vision, "recognize")
Rel(bot, services, "вызывает")
Rel(broker, services, "вызывает")
Rel(services, domain, "использует")
Rel(services, repos, "читает и пишет")
Rel(services, publisher, "publish")
Rel(services, classifier, "classify")
Rel(services, geo, "reverse")
Rel(services, pdf, "рендер")
Rel(services, files, "файлы")
Rel(publisher, redis, "kiq после коммита")
Rel(redis, broker, "задачи")
Rel(broker, vision, "фото из бота")
Rel(broker, speech, "голосовое")
Rel(broker, sender, "отправка")
Rel(repos, db, "SQL")
Rel(bot, redis, "FSM, диалоги")
Rel(geo, redis, "слот и кэш")
Rel(sender, botapi, "POST /messages, правка, закреп")
Rel(bot, botapi, "ответ через фасад апдейта")
Rel(classifier, yc, "completion", $tags="optional")
Rel(vision, yc, "recognizeText", $tags="optional")
Rel(speech, yc, "stt:recognize", $tags="optional")
Rel(geo, osm, "reverse", $tags="optional")
Rel(seed, services, "DemoService")
Rel(di, routes, "внедряет")
Rel(di, bot, "внедряет")
Rel(di, broker, "внедряет")

SHOW_LEGEND()
@enduml
