# Логи
LOG_LEVEL=DEBUG
# JSON в проде, PLAIN удобнее локально
LOG_FORMAT=PLAIN

# Веб-апишка
API_HOST=0.0.0.0
API_PORT=7001
API_WORKERS=1
# Пусто - CORS разрешён всем, иначе список источников через запятую
API_CORS=

# Постгрес
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=zheka
POSTGRES_PASSWORD=zheka
POSTGRES_DB=zheka

# Редис: FSM бота, очередь и расписание taskiq
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=zheka
REDIS_DB=0

# Бот
MAX_TOKEN=токен-бота-из-masterbot
# polling локально (не нужен ни домен, ни сертификат), webhook в проде
MAX_BOT_MODE=polling
# Полный публичный адрес вебхука, обязателен при MAX_BOT_MODE=webhook
MAX_WEBHOOK_URL=https://example.ru/webhook
# 5-256 символов из A-Z a-z 0-9 -, проверяется в заголовке X-Max-Bot-Api-Secret
MAX_SECRET_TOKEN=change-me-please
# Адрес мини-аппа для кнопки open_app
MAX_MINIAPP_URL=https://example.ru
