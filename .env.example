# Логи
LOG_LEVEL=DEBUG
# JSON в проде, PLAIN удобнее локально
LOG_FORMAT=PLAIN

# Веб-апишка: адрес слушателя, его читает gunicorn, а не приложение.
# Действует при запуске вне docker (just api), в compose адрес зафиксирован
# на 0.0.0.0:7001, потому что там на него завязаны nginx и healthcheck.
# Число воркеров не настраивается: gunicorn.conf.py берёт его по числу
# логических процессоров, а при MAX_BOT_MODE=polling оставляет один.
API_HOST=0.0.0.0
API_PORT=7001
# Пусто - CORS разрешён всем, иначе список источников через запятую
API_CORS=

# Постгрес
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=zheka
POSTGRES_PASSWORD=zheka
POSTGRES_DB=zheka

# Редис: FSM бота, очередь и расписание taskiq
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=zheka
REDIS_DB=0

# Бот
MAX_TOKEN=токен-бота-из-masterbot
# polling локально (не нужен ни домен, ни сертификат), webhook в проде
MAX_BOT_MODE=polling
# Полный публичный адрес вебхука, обязателен при MAX_BOT_MODE=webhook
MAX_WEBHOOK_URL=https://example.ru/webhook
# 5-256 символов из A-Z a-z 0-9 -, проверяется в заголовке X-Max-Bot-Api-Secret
MAX_SECRET_TOKEN=change-me-please

# Файлы: путь для загруженных фото. В docker compose это всегда /data/files
# внутри контейнера (bind mount на backend/content), значение ниже только для
# запуска вне docker, где just выполняет команды с рабочей директорией backend/
FILES_DIR=./content
# Максимальный размер загружаемого файла в мегабайтах
FILES_MAX_SIZE_MB=10

# Диплинки
# Скрытый код регистрации УК: обязателен, только ASCII, без него нет старта
DEEPLINK_ORG_REGISTER=change-me-please

# Nginx: единственный порт, опубликованный на хосте
NGINX_PORT=80
