# Уровень логов
LOG_LEVEL=DEBUG
# JSON в проде, PLAIN удобнее локально
LOG_FORMAT=PLAIN

API_HOST=0.0.0.0
API_PORT=7001
# Пусто - CORS разрешён всем, иначе список источников через запятую
API_CORS=
API_TEST_TOKEN=

# Постгрес
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=zheka
POSTGRES_PASSWORD=zheka
POSTGRES_DB=zheka

# Редис: FSM бота, очередь и расписание taskiq
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=zheka
REDIS_DB=0

# Токен бота
MAX_TOKEN=токен-бота-из-masterbot
# polling локально, webhook в проде
MAX_BOT_MODE=polling
# Полный публичный адрес вебхука, обязателен при MAX_BOT_MODE=webhook
MAX_WEBHOOK_URL=https://example.ru/webhook
# 5-256 символов из A-Z a-z 0-9 -, проверяется в заголовке X-Max-Bot-Api-Secret
MAX_SECRET_TOKEN=change-me-please

# Путь для загруженных файлов
FILES_DIR=./content
# Максимальный размер файла в мегабайтах
FILES_MAX_SIZE_MB=10
FILES_MAX_VIDEO_MB=50

# Диплинки
# Скрытый код регистрации УК: 1-64 символа из латиницы, цифр, _ и -
DEEPLINK_ORG_REGISTER=change-me-please

# Yandex Vision OCR (показание счетчика по фото)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Текстовая модель AI Studio, имя из gpt://<каталог>/<модель>
YANDEX_MODEL=yandexgpt-5-lite

# Порт, открытый на хосте
NGINX_PORT=80
